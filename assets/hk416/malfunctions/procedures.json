 "procedures": {
  "immediate_action": {
   "name": "Immediate action: tap, rack, reassess",
   "source": "TC 3-22.9 (2016) para 8-35, as summarised; the motions are those of the manual's loading note (p. 8) and clearing step 4 (p. 3)",
   "when": "The hammer fell with a click and nothing happened, and the cause is not known. Not for a pop or weak shot.",
   "end": "ready",
   "fallback": "remedial_clear",
   "attempts": 2,
   "steps": [
    {
     "action": "tap",
     "expect": "the magazine is latched"
    },
    {
     "action": "rack",
     "expect": "whatever was in the chamber is thrown out; a fresh round is chambered and the bolt locks"
    },
    {
     "action": "reassess",
     "expect": "bolt fully forward, port clear: ready"
    }
   ]
  },
  "misfire_range": {
   "name": "Misfire on a range: wait, then tap, rack, reassess",
   "source": "standard range practice for a possible hangfire, then TC 3-22.9 para 8-35",
   "when": "Click, no bang, no recoil, on a range where nothing is gained by hurrying.",
   "end": "ready",
   "fallback": "remedial_clear",
   "attempts": 1,
   "steps": [
    {
     "action": "wait",
     "expect": "if it was a hangfire the shot goes into the backstop and the rifle cycles; otherwise nothing happens",
     "args": {
      "seconds": 30
     }
    },
    {
     "action": "tap",
     "expect": "the magazine is latched"
    },
    {
     "action": "rack",
     "expect": "the dud is ejected, port towards the ground; a fresh round is chambered"
    },
    {
     "action": "reassess",
     "expect": "ready. The dud is set aside as the range directs"
    }
   ]
  },
  "stovepipe_clear": {
   "name": "Stove pipe",
   "source": "TC 3-22.9 (2016) para 8-36 remedial action, stove pipe, as summarised",
   "when": "A case is standing in, or lying in, the ejection port and the trigger is dead.",
   "end": "ready",
   "fallback": "remedial_clear",
   "attempts": 1,
   "steps": [
    {
     "action": "sweep_case",
     "expect": "the case is out and the bolt goes forward"
    },
    {
     "action": "rack",
     "expect": "the rifle is cycled: a fresh round is chambered"
    },
    {
     "action": "reassess",
     "expect": "ready"
    }
   ]
  },
  "double_feed_clear": {
   "name": "Double feed",
   "source": "TC 3-22.9 (2016) para 8-36 remedial action, double feed, as summarised: magazine out, clear, confirm, fresh magazine, chamber. Many instructors lock the bolt back first to take the spring off the wedged rounds",
   "when": "Brass and a second round are both at the chamber, or immediate action has failed twice.",
   "end": "ready",
   "fallback": "stuck_case_rod",
   "attempts": 1,
   "steps": [
    {
     "action": "strip_mag",
     "expect": "the magazine comes out; loose rounds may fall with it"
    },
    {
     "action": "rack",
     "expect": "whatever is loose drops through the magazine well; the extractor tries the chamber"
    },
    {
     "action": "rack",
     "expect": "second pull"
    },
    {
     "action": "lock_back",
     "expect": "bolt held open"
    },
    {
     "action": "inspect_chamber",
     "expect": "chamber and feedway empty",
     "branch": {
      "chamber_not_clear": "stuck_case_rod"
     }
    },
    {
     "action": "insert_mag",
     "expect": "a fresh loaded magazine is latched"
    },
    {
     "action": "release_bolt",
     "expect": "a round is chambered and the bolt locks"
    },
    {
     "action": "reassess",
     "expect": "ready to fire"
    }
   ]
  },
  "remedial_clear": {
   "name": "Remedial action",
   "source": "TC 3-22.9 (2016) para 8-36, as summarised: look, remove the magazine, clear, inspect, then act on what is found",
   "when": "Immediate action has failed twice, or the trigger will not press, or it feels soft.",
   "end": "ready",
   "fallback": "stuck_case_rod",
   "attempts": 1,
   "steps": [
    {
     "action": "strip_mag",
     "expect": "the magazine comes out; loose rounds may fall with it"
    },
    {
     "action": "rack",
     "expect": "whatever is loose drops through the magazine well; the extractor tries the chamber"
    },
    {
     "action": "rack",
     "expect": "second pull"
    },
    {
     "action": "lock_back",
     "expect": "bolt held open"
    },
    {
     "action": "inspect_chamber",
     "expect": "chamber and feedway empty",
     "branch": {
      "chamber_not_clear": "stuck_case_rod"
     }
    },
    {
     "action": "insert_mag",
     "expect": "a fresh loaded magazine is latched"
    },
    {
     "action": "release_bolt",
     "expect": "a round is chambered and the bolt locks"
    },
    {
     "action": "reassess",
     "expect": "ready to fire"
    }
   ]
  },
  "bolt_override_clear": {
   "name": "Bolt over-ride",
   "source": "TC 3-22.9 (2016) para 8-36 remedial action, bolt override, as summarised",
   "when": "A round is wedged above the bolt and the charging handle is bound.",
   "end": "ready",
   "fallback": "remedial_clear",
   "attempts": 1,
   "steps": [
    {
     "action": "strip_mag",
     "expect": "pressure from below is removed"
    },
    {
     "action": "handle_strike",
     "expect": "the bolt is driven back off the round, which drops through the magazine well"
    },
    {
     "action": "hold_bolt_strike",
     "expect": "second method, only if the first did not free it",
     "if": "handle_bound"
    },
    {
     "action": "lock_back",
     "expect": "bolt held open"
    },
    {
     "action": "inspect_chamber",
     "expect": "chamber and feedway empty",
     "branch": {
      "chamber_not_clear": "stuck_case_rod"
     }
    },
    {
     "action": "insert_mag",
     "expect": "a fresh loaded magazine is latched"
    },
    {
     "action": "release_bolt",
     "expect": "a round is chambered and the bolt locks"
    },
    {
     "action": "reassess",
     "expect": "ready"
    }
   ]
  },
  "squib_stop": {
   "name": "Pop or weak shot: stop, unload, prove the bore",
   "source": "standard range practice; the unloading and the rod check are the manual's clearing steps 2 to 6 (p. 3), and a clear bore is one of its conditions for handling (p. 4, rule 3)",
   "when": "A pop or weak report, little recoil, the action did not cycle. Any one of these is enough to stop.",
   "end": "made_safe",
   "fallback": null,
   "attempts": 1,
   "steps": [
    {
     "action": "strip_mag",
     "expect": "no round can feed"
    },
    {
     "action": "lock_back",
     "expect": "the fired case is drawn out and the bolt held open; the hammer is now cocked"
    },
    {
     "action": "safe",
     "expect": "selector on safe"
    },
    {
     "action": "inspect_chamber",
     "expect": "chamber empty"
    },
    {
     "action": "check_bore",
     "expect": "the rod stops short: a bullet is in the bore"
    },
    {
     "action": "rod",
     "expect": "the bullet is driven out by an armourer and the barrel inspected; the rifle is out of use until then"
    }
   ]
  },
  "stuck_case_rod": {
   "name": "Case stuck in the chamber",
   "source": "the manual's clearing steps (p. 3) and its tool list, which includes a 5.56 mm broken shell extractor (p. 17)",
   "when": "A fired case is still in the chamber and racking does not bring it out.",
   "end": "ready",
   "fallback": null,
   "attempts": 1,
   "steps": [
    {
     "action": "strip_mag",
     "expect": "no round can feed onto the case",
     "if": "mag_in"
    },
    {
     "action": "lock_back",
     "expect": "bolt held open"
    },
    {
     "action": "safe",
     "expect": "selector on safe"
    },
    {
     "action": "rod",
     "expect": "the case is pushed out from the muzzle end and falls through the magazine well"
    },
    {
     "action": "inspect_chamber",
     "expect": "chamber empty"
    },
    {
     "action": "selector_fire",
     "expect": "selector back to semi"
    },
    {
     "action": "insert_mag",
     "expect": "a loaded magazine is latched"
    },
    {
     "action": "release_bolt",
     "expect": "a round is chambered and the bolt locks"
    },
    {
     "action": "reassess",
