  "anchor_rifle_db": {
   "value": 140.0,
   "status": "published",
   "source": "about 140 dB peak for a .22 calibre rifle (cited in a firearm suppressor study, PMC8588962). Its measuring position is not stated; taken here as the shooter's ear"
  },
  "bracket_1m_left_db": {
   "value": [
    149.0,
    167.0
   ],
   "status": "published",
   "source": "Flamme et al.: instantaneous peak levels 1 m to the shooter's left ranged from 149 to 167 dB across 15 recreational firearms (as summarised in CDC stacks 211059)"
  },
  "efflux_exponent": {
   "value": 0.55,
   "status": "inferred",
   "source": "peak overpressure ~ (muzzle energy efflux rate)^0.55, from the blast scaling length ~ sqrt(efflux) and peak ~ length^1.1 (Fansler and Schmidt muzzle blast scaling, recalled, not re-read)"
  },
  "decay_exponent": {
   "value": 1.1,
   "status": "inferred",
   "source": "peak ~ r^-1.1: weak-shock decay, same scaling"
  },
  "directivity_db": {
   "value": 6.0,
   "status": "inferred",
   "source": "level(theta) = level(90 deg) + 6 cos(theta) dB: louder ahead of the muzzle, quieter behind. Typical of small arms, not measured for this pistol"
  },
  "t_pos_ref": {
   "value": 0.00025,
   "status": "inferred",
   "source": "positive phase of the standard-velocity blast at 1 m; small-arms values are 0.2 to 0.5 ms"
  },
  "friedlander_b": {
   "value": 1.5,
   "status": "inferred",
   "source": "decay constant of the Friedlander wave"
  },
  "rise_time": {
   "value": 4e-05,
   "status": "inferred",
   "source": "shock rise seen through a 48 kHz system"
  },
  "ground_reflection": {
   "value": 0.75,
   "status": "inferred",
   "source": "pressure reflection coefficient of range ground (grass over soil), broadband"
  },
  "air_lp": {
   "value": 300000.0,
   "status": "inferred",
   "source": "air absorption as a one-pole low-pass with corner 3e5 / r Hz (a rough fit to ISO 9613-1 at 20 C, 50 % RH)"
  },
  "radiation_efficiency": {
   "value": 0.002,
   "status": "inferred",
   "source": "share of a mechanical impact's lost energy that leaves as sound"
  },
  "rifle_ear": {
